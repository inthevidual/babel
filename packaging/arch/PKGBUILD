# Maintainer: inthevidual <jesper@jespersandstrom.se>
pkgname=babel-desktop-git
pkgver=r0
pkgrel=1
pkgdesc='Translate Word documents side by side, with the layout intact (KDE desktop app)'
arch=('x86_64')
url='https://github.com/inthevidual/babel'
license=('LicenseRef-unknown')
depends=('qt6-base' 'qt6-declarative' 'qt6-webengine' 'kirigami' 'qqc2-desktop-style'
         'hicolor-icon-theme' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'rust-wasm' 'wasm-bindgen')
provides=('babel-desktop')
conflicts=('babel-desktop')
options=('!lto')
source=("babel::git+https://github.com/inthevidual/babel.git#branch=native")
sha256sums=('SKIP')

pkgver() {
  cd babel
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd babel
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
  cargo fetch --locked --target wasm32-unknown-unknown
}

build() {
  cd babel
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The editor in WebAssembly, embedded in the app's web editor.
  cargo build --frozen --profile wasm -p babel-wasm --target wasm32-unknown-unknown
  wasm-bindgen --target web --no-typescript --out-dir web/wasm target/wasm32-unknown-unknown/wasm/babel_wasm.wasm
  cargo build --frozen --release -p babel-desktop
}

check() {
  cd babel
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release -p babel-core -p babel-sync -p babel-docx -p babel-pages -p babel-editor
}

package() {
  cd babel
  install -Dm755 target/release/babel-desktop "$pkgdir/usr/bin/babel-desktop"
  install -Dm644 packaging/se.cptjanst.babel.desktop "$pkgdir/usr/share/applications/se.cptjanst.babel.desktop"
  install -Dm644 packaging/se.cptjanst.babel.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/se.cptjanst.babel.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  # Native layout uses WordCraft (MIT or Apache-2.0); its notices ship with the binary.
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  cp -r packaging/notices/. "$pkgdir/usr/share/licenses/$pkgname/"
}
