[
{"settings": {"proof": true, "endpoint": "@LT@"}},
{"open": "@REPO@/test/fixtures/sample.docx", "lang": "sv-SE", "wait": 2000},
{"textView": false, "menu": "actualSize:", "wait": 800},
{"name": "opened", "expect": {"editing": true, "project": "sample", "projects": 1}},
{"name": "click places the caret", "click": ["t", 0, 150, 112]},
{"name": "click places the caret", "expect": {"selectedSome": false, "para": "document:1"}},
{"name": "typing", "type": "Hej ", "wait": 300},
{"name": "typing", "expect": {"chars": 5538, "unsaved": true}},
{"name": "backspace", "key": "backspace"},
{"name": "backspace", "expect": {"chars": 5537}},
{"name": "double-click selects a word", "click": ["t", 0, 110, 152], "count": 2, "wait": 400},
{"name": "double-click selects a word", "expect": {"selected": "report", "para": "document:2"}},
{"name": "cmd-B formats the selection", "key": "b", "mods": ["cmd"]},
{"name": "cmd-B formats the selection", "expect": {"selected": "report"}},
{"name": "cmd-Z undoes", "key": "z", "mods": ["cmd"]},
{"name": "shift-left selects", "click": ["t", 0, 150, 112]},
{"key": "left", "mods": ["shift"]},
{"key": "left", "mods": ["shift"]},
{"name": "shift-left selects", "expect": {"selectedSome": true}},
{"name": "a click in the original goes to the translation", "click": ["s", 0, 150, 160]},
{"name": "a click in the original goes to the translation", "expect": {"para": "document:2", "selectedSome": false}},
{"name": "cmd-return marks done and goes on", "key": "\r", "mods": ["cmd"]},
{"name": "cmd-return marks done and goes on", "expect": {"para": "document:3", "doneCount": 2}},
{"name": "return goes to the next paragraph", "key": "return"},
{"name": "return goes to the next paragraph", "expect": {"para": "document:4"}},
{"grab": "@OUT@/pages.png", "wait": 1500},
{"name": "text view", "textView": true, "wait": 800},
{"name": "text view", "expect": {"textView": true, "firstResponder": "RowTextView"}},
{"name": "typing in a row", "type": "Z", "wait": 400},
{"name": "typing in a row", "expect": {"chars": 5538, "para": "document:0"}},
{"grab": "@OUT@/text.png", "wait": 500},
{"name": "zoom in the text view", "menu": "actualSize:", "wait": 300},
{"name": "zoom in the text view", "menu": "zoomIn:", "wait": 500},
{"name": "zoom in the text view", "expect": {"textZoom": 1.1, "zoom": 1}},
{"grab": "@OUT@/text-zoomed.png", "wait": 300},
{"name": "zoom in the text view", "menu": "actualSize:", "wait": 300},
{"name": "zoom in the text view", "expect": {"textZoom": 1}},
{"name": "only segments with issues", "onlyOpen": false, "onlyIssues": true, "wait": 500},
{"name": "only segments with issues", "expect": {"rowsFiltered": true, "allWithIssues": true}},
{"grab": "@OUT@/text-issues.png", "wait": 300},
{"name": "only segments not done", "onlyOpen": true, "onlyIssues": false, "wait": 400},
{"name": "only segments not done", "expect": {"rowsFiltered": true, "rowsDone": 0}},
{"name": "both filters", "onlyOpen": true, "onlyIssues": true, "wait": 400},
{"name": "both filters", "expect": {"rowsFiltered": true, "allWithIssues": true, "rowsDone": 0}},
{"name": "no filter", "onlyOpen": false, "onlyIssues": false, "wait": 400},
{"name": "no filter", "expect": {"rowsFiltered": false}},
{"name": "back to the pages", "textView": false, "wait": 1500},
